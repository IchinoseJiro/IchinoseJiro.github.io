{
  "name": "webportfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests *.html *.json *.js *.md",
    "format:check": "prettier --check src tests *.html *.json *.js *.md",
    "check": "npm run test && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
